{
    "stasis": {
        "name": "Stasis",
        "description": "While active, no tick functions run on this nation/character — except its own modifier decay, so this modifier's duration still counts down and it can expire on its own. Nation market demands are wiped each tick while in stasis, and existing trade routes involving the nation stay active but stop delivering resources until it ends. The value field is ignored — duration controls how many sessions stasis lasts.",
        "value_format": "number",
        "field_template": "_stasis_flag",
        "is_stasis": true,
        "applicable_to": ["nation", "character"]
    },
    "district_duration": {
        "name": "District Duration Scaling",
        "description": "Tracks how many sessions this district has been active. The value field is ignored — place this on a district to enable session tracking. Other modifiers on the district can then use the 'Per X District Sessions' scaling method.",
